<?xml version="1.0" encoding="utf-8"?>
<!-- Only WhatsApp windows are delivered to the reply reader; it never acts, only reads. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowContentChanged|typeWindowStateChanged|typeViewScrolled"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:canPerformGestures="false"
    android:description="@string/reply_reader_description"
    android:notificationTimeout="500"
    android:packageNames="com.whatsapp,com.whatsapp.w4b"
    android:summary="@string/reply_reader_summary" />
